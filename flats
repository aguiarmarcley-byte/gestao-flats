:root{--green:#173b35;--green2:#24584e;--mint:#e8f1ed;--ink:#1d2c29;--muted:#71817c;--line:#e3e9e6;--bg:#f5f7f6;--white:#fff;--gold:#d8a74a;--red:#bd5148;--shadow:0 8px 24px rgba(20,50,43,.06)}
*{box-sizing:border-box}body{margin:0;background:var(--bg);font-family:Inter,ui-sans-serif,system-ui,-apple-system,"Segoe UI",sans-serif;color:var(--ink)}button,input,select,textarea{font:inherit}.app-shell{display:flex;min-height:100vh}.sidebar{width:250px;background:var(--green);color:#fff;padding:25px 16px;display:flex;flex-direction:column;flex-shrink:0}.brand{display:flex;gap:12px;align-items:center;padding:0 10px 30px}.brand-logo{width:52px;height:52px;flex:0 0 52px;object-fit:cover;border-radius:50%;background:#fff;border:2px solid rgba(255,255,255,.35)}.brand strong{display:block;font-size:15px}.brand small{display:block;color:#b9cec6;font-size:11px;margin-top:3px}.sidebar nav{display:grid;gap:7px}.nav-link{border:0;background:transparent;color:#c6d7d1;text-align:left;padding:12px 13px;border-radius:10px;cursor:pointer;display:flex;gap:12px;align-items:center;font-size:14px}.nav-link:hover,.nav-link.active{background:#2b594f;color:white}.nav-link:first-letter{font-size:18px}.sidebar-foot{margin-top:auto;color:#bdd0c9;font-size:11px;padding:18px 10px 0}.status-dot{display:inline-block;width:7px;height:7px;border-radius:50%;background:#8ad3a8;margin-right:7px}.main{flex:1;min-width:0}.topbar{height:100px;background:#fff;border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;padding:20px 36px;position:sticky;top:0;z-index:5}.eyebrow{font-size:10px;letter-spacing:1.6px;color:var(--muted);font-weight:700}.topbar h1{font-size:23px;margin:4px 0 0}.top-actions{display:flex;align-items:center;gap:15px}.today{color:var(--muted);font-size:12px}.page-content{padding:28px 36px;max-width:1500px;margin:auto}footer{padding:10px 36px 25px;color:#9aa7a2;font-size:11px}.menu-btn{display:none;border:0;background:transparent;font-size:22px}.grid{display:grid;gap:17px}.stats{grid-template-columns:repeat(4,minmax(0,1fr));margin-bottom:22px}.card{background:white;border:1px solid var(--line);border-radius:15px;padding:19px;box-shadow:var(--shadow)}.stat-label{font-size:12px;color:var(--muted)}.stat-value{font-size:28px;font-weight:750;margin:9px 0 4px;letter-spacing:-1px}.stat-note{font-size:11px;color:#91a09a}.two-col{grid-template-columns:1.25fr .75fr}.section-head{display:flex;align-items:center;justify-content:space-between;gap:12px;margin:5px 0 14px}.section-head h2{font-size:16px;margin:0}.section-head p{font-size:12px;color:var(--muted);margin:4px 0 0}.btn{border:0;border-radius:9px;padding:10px 14px;cursor:pointer;font-weight:650;font-size:12px}.btn-primary{background:var(--green2);color:white}.btn-primary:hover{background:var(--green)}.btn-light{background:var(--mint);color:var(--green)}.btn-danger{background:#fae9e7;color:#a63e36}.btn-small{padding:7px 10px;font-size:11px}.actions{display:flex;gap:8px;flex-wrap:wrap}.table-wrap{overflow:auto}table{width:100%;border-collapse:collapse;font-size:12px}th{text-align:left;color:#87948f;font-weight:650;font-size:10px;text-transform:uppercase;letter-spacing:.7px;padding:12px 10px;border-bottom:1px solid var(--line)}td{padding:13px 10px;border-bottom:1px solid #eef1ef;white-space:nowrap}tr:last-child td{border-bottom:0}.empty{text-align:center;padding:28px;color:var(--muted);font-size:13px}.pill{display:inline-flex;padding:5px 8px;border-radius:20px;background:var(--mint);color:var(--green2);font-size:10px;font-weight:700}.pill.warn{background:#fff3db;color:#936717}.pill.red{background:#fae9e7;color:#a63e36}.form-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:13px}.field{display:grid;gap:6px}.field.full{grid-column:1/-1}.field label{font-size:11px;color:#65746e;font-weight:700}.field input,.field select,.field textarea{width:100%;border:1px solid #dce5e0;border-radius:9px;padding:11px 12px;background:#fff;color:var(--ink);outline:none}.field input:focus,.field select:focus,.field textarea:focus{border-color:#6d9a8b;box-shadow:0 0 0 3px #e8f1ed}.field textarea{min-height:75px;resize:vertical}.form-actions{display:flex;justify-content:flex-end;gap:8px;margin-top:16px}.modal-backdrop{position:fixed;inset:0;background:#142a25a8;display:grid;place-items:center;padding:20px;z-index:20}.modal{width:min(620px,100%);max-height:90vh;overflow:auto;background:#fff;border-radius:16px;padding:23px;box-shadow:0 20px 70px #0003}.modal h2{margin:0 0 18px;font-size:19px}.toast{position:fixed;bottom:22px;right:22px;background:#173b35;color:#fff;padding:12px 17px;border-radius:10px;font-size:12px;opacity:0;transform:translateY(8px);transition:.2s;z-index:40;pointer-events:none}.toast.show{opacity:1;transform:translateY(0)}.quick-list{display:grid;gap:12px}.quick-item{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:10px 0;border-bottom:1px solid #edf1ef;font-size:12px}.quick-item:last-child{border:0}.muted{color:var(--muted)}.mobile-panel{max-width:680px;margin:auto}.mobile-panel .card{padding:23px}.flat-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}.flat{border:1px solid var(--line);border-radius:10px;padding:13px;text-align:center;cursor:pointer}.flat.selected{border-color:var(--green2);background:var(--mint)}.flat strong{display:block;font-size:14px}.flat small{color:var(--muted);font-size:10px}.progress{height:7px;background:#edf1ef;border-radius:10px;overflow:hidden}.progress span{display:block;height:100%;background:#5d927f}.notice{background:#f1f6f3;border:1px solid #dce9e2;padding:13px;border-radius:10px;color:#47675c;font-size:12px;line-height:1.6}.report-grid{grid-template-columns:repeat(3,1fr)}@media(max-width:1050px){.stats{grid-template-columns:repeat(2,1fr)}.two-col{grid-template-columns:1fr}.page-content{padding:22px}.topbar{padding:18px 22px}}@media(max-width:720px){.sidebar{position:fixed;z-index:30;left:-260px;top:0;bottom:0;transition:.25s}.sidebar.open{left:0}.menu-btn{display:block}.topbar{height:82px;gap:12px}.topbar h1{font-size:18px}.today{display:none}.page-content{padding:17px}.stats{gap:10px}.card{padding:15px}.stat-value{font-size:23px}.form-grid{grid-template-columns:1fr}.field.full{grid-column:auto}.report-grid{grid-template-columns:1fr}.flat-grid{grid-template-columns:repeat(2,1fr)}footer{padding:10px 18px 22px}}

const $ = s => document.querySelector(s);
const money = n => (Number(n)||0).toLocaleString('pt-BR',{style:'currency',currency:'BRL'});
const todayISO = () => new Date().toISOString().slice(0,10);
const fmtDate = d => d ? new Date(d+'T12:00:00').toLocaleDateString('pt-BR') : '—';
const initial = {reservas:[],hospedes:[],lancamentos:[],tarefas:[],manutencoes:[]};
let db = loadDB(), currentPage='dashboard';
function loadDB(){try{return {...initial,...JSON.parse(localStorage.getItem('casaSer gioDB')||localStorage.getItem('casa-sergio-db')||'{}')}}catch{return {...initial}}}
function save(){localStorage.setItem('casa-sergio-db',JSON.stringify(db));}
function toast(msg){const t=$('#toast');t.textContent=msg;t.classList.add('show');setTimeout(()=>t.classList.remove('show'),2400)}
function setPage(page){currentPage=page;document.querySelectorAll('.nav-link').forEach(b=>b.classList.toggle('active',b.dataset.page===page));$('#pageTitle').textContent=({dashboard:'Painel geral',reservas:'Reservas',hospedes:'Hóspedes',financeiro:'Financeiro',operacao:'Limpeza e operação',manutencao:'Manutenção',mobile:'Check-in / Check-out',relatorios:'Relatórios'})[page];render();$('#sidebar').classList.remove('open')}
$('#nav').addEventListener('click',e=>{const b=e.target.closest('[data-page]');if(b)setPage(b.dataset.page)});
$('#menuBtn').onclick=()=>$('#sidebar').classList.toggle('open');
$('#today').textContent=new Date().toLocaleDateString('pt-BR',{weekday:'short',day:'2-digit',month:'short',year:'numeric'});
$('#backupBtn').onclick=()=>{const blob=new Blob([JSON.stringify(db,null,2)],{type:'application/json'});download(blob,'backup-casa-do-sergio.json');toast('Backup exportado')};
function download(blob,name){const a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download=name;a.click();URL.revokeObjectURL(a.href)}
function nights(a,b){return Math.max(1,Math.round((new Date(b+'T12:00:00')-new Date(a+'T12:00:00'))/86400000))}
function totalReservas(){return db.reservas.reduce((s,r)=>s+Number(r.valor||0),0)}
function recebido(){return db.lancamentos.filter(x=>x.tipo==='Receita').reduce((s,x)=>s+Number(x.valor||0),0)}
function despesas(){return db.lancamentos.filter(x=>x.tipo==='Despesa').reduce((s,x)=>s+Number(x.valor||0),0)}
function render(){const p=$('#page');({dashboard:dashboard,reservas:reservas,hospedes:hospedes,financeiro:financeiro,operacao:operacao,manutencao:manutencao,mobile:mobile,relatorios:relatorios})[currentPage](p)}
function dashboard(p){const hoje=todayISO(),ocup=db.reservas.filter(r=>r.status!=='Cancelada'&&r.checkin<=hoje&&r.checkout>hoje).length,chegadas=db.reservas.filter(r=>r.status!=='Cancelada'&&r.checkin===hoje).length,saidas=db.reservas.filter(r=>r.status!=='Cancelada'&&r.checkout===hoje).length;
p.innerHTML=`<div class="grid stats">
<div class="card"><div class="stat-label">Reservas cadastradas</div><div class="stat-value">${db.reservas.length}</div><div class="stat-note">Todas as reservas registradas</div></div>
<div class="card"><div class="stat-label">Flats ocupados hoje</div><div class="stat-value">${ocup} <span class="muted" style="font-size:15px">/ 6</span></div><div class="progress"><span style="width:${ocup/6*100}%"></span></div></div>
<div class="card"><div class="stat-label">Receitas registradas</div><div class="stat-value">${money(recebido())}</div><div class="stat-note">Lançamentos de receita</div></div>
<div class="card"><div class="stat-label">Saldo registrado</div><div class="stat-value">${money(recebido()-despesas())}</div><div class="stat-note">Receitas menos despesas</div></div></div>
<div class="grid two-col"><div class="card"><div class="section-head"><div><h2>Agenda de hoje</h2><p>Movimentações previstas para ${fmtDate(hoje)}</p></div><button class="btn btn-primary" onclick="setPage('mobile')">Abrir operação</button></div>
<div class="quick-list"><div class="quick-item"><span>Check-ins previstos</span><strong>${chegadas}</strong></div><div class="quick-item"><span>Check-outs previstos</span><strong>${saidas}</strong></div><div class="quick-item"><span>Flats ocupados</span><strong>${ocup} de 6</strong></div></div></div>
<div class="card"><div class="section-head"><div><h2>Acesso rápido</h2><p>Rotinas principais da pousada</p></div></div><div class="quick-list"><button class="btn btn-light" onclick="openReservation()">＋ Nova reserva</button><button class="btn btn-light" onclick="setPage('financeiro')">＋ Lançar receita ou despesa</button><button class="btn btn-light" onclick="setPage('operacao')">☑ Ver tarefas de limpeza</button><button class="btn btn-light" onclick="setPage('manutencao')">⚙ Registrar manutenção</button></div></div></div>
<div class="card" style="margin-top:18px"><div class="section-head"><div><h2>Próximas reservas</h2><p>Reservas futuras não canceladas</p></div><button class="btn btn-light" onclick="setPage('reservas')">Ver todas</button></div>${reservationTable(db.reservas.filter(r=>r.checkout>=hoje&&r.status!=='Cancelada').sort((a,b)=>a.checkin.localeCompare(b.checkin)).slice(0,5))}</div>`}
function reservationTable(list){if(!list.length)return '<div class="empty">Nenhuma reserva cadastrada.</div>';return `<div class="table-wrap"><table><thead><tr><th>Hóspede</th><th>Flat</th><th>Entrada</th><th>Saída</th><th>Valor</th><th>Status</th><th></th></tr></thead><tbody>${list.map(r=>`<tr><td><strong>${esc(r.nome)}</strong></td><td>${esc(r.flat)}</td><td>${fmtDate(r.checkin)}</td><td>${fmtDate(r.checkout)}</td><td>${money(r.valor)}</td><td>${statusPill(r.status)}</td><td><button class="btn btn-light btn-small" onclick="editReservation('${r.id}')">Editar</button></td></tr>`).join('')}</tbody></table></div>`}
function statusPill(s){return `<span class="pill ${s==='Cancelada'?'red':s==='Pendente'?'warn':''}">${esc(s||'Confirmada')}</span>`}
function reservas(p){p.innerHTML=`<div class="section-head"><div><h2>Controle de reservas</h2><p>Cadastre estadias e evite sobreposição no mesmo flat.</p></div><button class="btn btn-primary" onclick="openReservation()">＋ Nova reserva</button></div><div class="card">${reservationTable(db.reservas.sort((a,b)=>a.checkin.localeCompare(b.checkin)))}</div>`}
function openReservation(id){const r=db.reservas.find(x=>x.id===id)||{};modal(`<h2>${id?'Editar reserva':'Nova reserva'}</h2><form id="reservationForm"><div class="form-grid">
<div class="field full"><label>Nome do hóspede</label><input name="nome" required value="${attr(r.nome||'')}"></div>
<div class="field"><label>Flat</label><select name="flat">${['Flat 1','Flat 2','Flat 3','Flat 4','Flat 5','Flat 6'].map(x=>`<option ${r.flat===x?'selected':''}>${x}</option>`).join('')}</select></div>
<div class="field"><label>Quantidade de hóspedes</label><input type="number" name="pessoas" min="1" value="${r.pessoas||2}"></div>
<div class="field"><label>Check-in</label><input type="date" name="checkin" required value="${r.checkin||todayISO()}"></div>
<div class="field"><label>Check-out</label><input type="date" name="checkout" required value="${r.checkout||todayISO()}"></div>
<div class="field"><label>Valor total (R$)</label><input type="number" name="valor" min="0" step=".01" required value="${r.valor||''}"></div>
<div class="field"><label>Status</label><select name="status">${['Confirmada','Pendente','Hospedado','Concluída','Cancelada'].map(x=>`<option ${r.status===x?'selected':''}>${x}</option>`).join('')}</select></div>
<div class="field"><label>Origem</label><select name="origem">${['Direta','Booking','Airbnb','Telefone/WhatsApp','Outra'].map(x=>`<option ${r.origem===x?'selected':''}>${x}</option>`).join('')}</select></div>
<div class="field full"><label>Observações</label><textarea name="obs">${esc(r.obs||'')}</textarea></div></div><div class="form-actions"><button type="button" class="btn btn-light" onclick="closeModal()">Cancelar</button><button class="btn btn-primary">Salvar reserva</button></div></form>`);
$('#reservationForm').onsubmit=e=>{e.preventDefault();const d=Object.fromEntries(new FormData(e.target));if(d.checkout<=d.checkin){toast('A saída deve ser posterior à entrada');return}const conflict=db.reservas.some(x=>x.id!==id&&x.flat===d.flat&&x.status!=='Cancelada'&&d.checkin<x.checkout&&d.checkout>x.checkin);if(conflict){toast('Já existe reserva sobreposta para este flat');return}const obj={...d,id:id||crypto.randomUUID(),valor:Number(d.valor),pessoas:Number(d.pessoas)};if(id)db.reservas=db.reservas.map(x=>x.id===id?obj:x);else db.reservas.push(obj);if(!db.hospedes.some(h=>h.nome.toLowerCase()===d.nome.toLowerCase()))db.hospedes.push({id:crypto.randomUUID(),nome:d.nome,telefone:'',documento:''});save();closeModal();render();toast('Reserva salva')}}
function editReservation(id){openReservation(id)}
function hospedes(p){p.innerHTML=`<div class="section-head"><div><h2>Cadastro de hóspedes</h2><p>Contatos e histórico de hospedagem.</p></div><button class="btn btn-primary" onclick="openGuest()">＋ Novo hóspede</button></div><div class="card">${db.hospedes.length?`<div class="table-wrap"><table><thead><tr><th>Nome</th><th>Telefone</th><th>Documento</th><th>Reservas</th><th></th></tr></thead><tbody>${db.hospedes.map(h=>`<tr><td><strong>${esc(h.nome)}</strong></td><td>${esc(h.telefone||'—')}</td><td>${esc(h.documento||'—')}</td><td>${db.reservas.filter(r=>r.nome.toLowerCase()===h.nome.toLowerCase()).length}</td><td><button class="btn btn-light btn-small" onclick="openGuest('${h.id}')">Editar</button></td></tr>`).join('')}</tbody></table></div>`:'<div class="empty">Nenhum hóspede cadastrado.</div>'}</div>`}
function openGuest(id){const h=db.hospedes.find(x=>x.id===id)||{};modal(`<h2>${id?'Editar hóspede':'Novo hóspede'}</h2><form id="guestForm"><div class="form-grid"><div class="field full"><label>Nome completo</label><input name="nome" required value="${attr(h.nome||'')}"></div><div class="field"><label>Telefone</label><input name="telefone" value="${attr(h.telefone||'')}"></div><div class="field"><label>Documento (opcional)</label><input name="documento" value="${attr(h.documento||'')}"></div><div class="field full"><label>E-mail</label><input name="email" type="email" value="${attr(h.email||'')}"></div></div><div class="form-actions"><button type="button" class="btn btn-light" onclick="closeModal()">Cancelar</button><button class="btn btn-primary">Salvar</button></div></form>`);$('#guestForm').onsubmit=e=>{e.preventDefault();let d=Object.fromEntries(new FormData(e.target));if(id)db.hospedes=db.hospedes.map(x=>x.id===id?{...x,...d}:x);else db.hospedes.push({...d,id:crypto.randomUUID()});save();closeModal();render();toast('Hóspede salvo')}}
function financeiro(p){p.innerHTML=`<div class="grid stats"><div class="card"><div class="stat-label">Receitas</div><div class="stat-value">${money(recebido())}</div></div><div class="card"><div class="stat-label">Despesas</div><div class="stat-value">${money(despesas())}</div></div><div class="card"><div class="stat-label">Saldo</div><div class="stat-value">${money(recebido()-despesas())}</div></div><div class="card"><div class="stat-label">Lançamentos</div><div class="stat-value">${db.lancamentos.length}</div></div></div><div class="section-head"><div><h2>Movimentações financeiras</h2><p>Registre valores efetivamente recebidos ou pagos.</p></div><button class="btn btn-primary" onclick="openEntry()">＋ Novo lançamento</button></div><div class="card">${db.lancamentos.length?`<div class="table-wrap"><table><thead><tr><th>Data</th><th>Tipo</th><th>Categoria</th><th>Descrição</th><th>Forma</th><th>Valor</th><th></th></tr></thead><tbody>${db.lancamentos.sort((a,b)=>b.data.localeCompare(a.data)).map(x=>`<tr><td>${fmtDate(x.data)}</td><td>${x.tipo==='Receita'?'<span class="pill">Receita</span>':'<span class="pill red">Despesa</span>'}</td><td>${esc(x.categoria)}</td><td>${esc(x.descricao)}</td><td>${esc(x.forma)}</td><td><strong>${money(x.valor)}</strong></td><td><button class="btn btn-danger btn-small" onclick="deleteEntry('${x.id}')">Excluir</button></td></tr>`).join('')}</tbody></table></div>`:'<div class="empty">Nenhum lançamento financeiro.</div>'}</div>`}
function openEntry(){modal(`<h2>Novo lançamento</h2><form id="entryForm"><div class="form-grid"><div class="field"><label>Tipo</label><select name="tipo"><option>Receita</option><option>Despesa</option></select></div><div class="field"><label>Data</label><input type="date" name="data" value="${todayISO()}" required></div><div class="field"><label>Categoria</label><select name="categoria">${['Diárias','Sinal/Adiantamento','Limpeza','Lavanderia','Manutenção','Energia','Água','Internet','Material','Taxas de plataforma','Outros'].map(x=>`<option>${x}</option>`).join('')}</select></div><div class="field"><label>Valor (R$)</label><input type="number" name="valor" min=".01" step=".01" required></div><div class="field"><label>Forma de pagamento</label><select name="forma">${['Pix','Dinheiro','Cartão','Transferência','Plataforma','Boleto','Outro'].map(x=>`<option>${x}</option>`).join('')}</select></div><div class="field"><label>Descrição</label><input name="descricao" required></div></div><div class="form-actions"><button type="button" class="btn btn-light" onclick="closeModal()">Cancelar</button><button class="btn btn-primary">Salvar lançamento</button></div></form>`);$('#entryForm').onsubmit=e=>{e.preventDefault();let d=Object.fromEntries(new FormData(e.target));db.lancamentos.push({...d,id:crypto.randomUUID(),valor:Number(d.valor)});save();closeModal();render();toast('Lançamento registrado')}}
function deleteEntry(id){if(confirm('Excluir este lançamento?')){db.lancamentos=db.lancamentos.filter(x=>x.id!==id);save();render();toast('Lançamento excluído')}}
function operacao(p){p.innerHTML=`<div class="section-head"><div><h2>Limpeza e enxoval</h2><p>Organize a preparação dos flats entre estadias.</p></div><button class="btn btn-primary" onclick="openTask()">＋ Nova tarefa</button></div><div class="card">${db.tarefas.length?`<div class="quick-list">${db.tarefas.map(t=>`<div class="quick-item"><div><strong>${esc(t.titulo)}</strong><div class="muted">${esc(t.flat)} · ${fmtDate(t.data)} · ${esc(t.responsavel||'Sem responsável')}</div></div><div class="actions"><span class="pill ${t.status==='Concluída'?'':'warn'}">${t.status}</span><button class="btn btn-light btn-small" onclick="toggleTask('${t.id}')">${t.status==='Concluída'?'Reabrir':'Concluir'}</button></div></div>`).join('')}</div>`:'<div class="empty">Nenhuma tarefa cadastrada.</div>'}</div>`}
function openTask(){modal(`<h2>Nova tarefa operacional</h2><form id="taskForm"><div class="form-grid"><div class="field full"><label>Tarefa</label><input name="titulo" placeholder="Ex.: Limpar banheiro e trocar enxoval" required></div><div class="field"><label>Flat</label><select name="flat">${['Todos','Flat 1','Flat 2','Flat 3','Flat 4','Flat 5','Flat 6'].map(x=>`<option>${x}</option>`).join('')}</select></div><div class="field"><label>Data prevista</label><input type="date" name="data" value="${todayISO()}"></div><div class="field full"><label>Responsável</label><input name="responsavel"></div></div><div class="form-actions"><button type="button" class="btn btn-light" onclick="closeModal()">Cancelar</button><button class="btn btn-primary">Criar tarefa</button></div></form>`);$('#taskForm').onsubmit=e=>{e.preventDefault();db.tarefas.push({...Object.fromEntries(new FormData(e.target)),id:crypto.randomUUID(),status:'Pendente'});save();closeModal();render();toast('Tarefa criada')}}
function toggleTask(id){db.tarefas=db.tarefas.map(t=>t.id===id?{...t,status:t.status==='Concluída'?'Pendente':'Concluída'}:t);save();render()}
function manutencao(p){p.innerHTML=`<div class="section-head"><div><h2>Manutenção</h2><p>Registre ocorrências, prioridades e andamento.</p></div><button class="btn btn-primary" onclick="openMaintenance()">＋ Registrar ocorrência</button></div><div class="card">${db.manutencoes.length?`<div class="table-wrap"><table><thead><tr><th>Data</th><th>Local</th><th>Problema</th><th>Prioridade</th><th>Status</th><th></th></tr></thead><tbody>${db.manutencoes.map(m=>`<tr><td>${fmtDate(m.data)}</td><td>${esc(m.local)}</td><td>${esc(m.problema)}</td><td>${esc(m.prioridade)}</td><td><span class="pill ${m.status==='Concluída'?'':'warn'}">${m.status}</span></td><td><button class="btn btn-light btn-small" onclick="finishMaintenance('${m.id}')">${m.status==='Concluída'?'Reabrir':'Concluir'}</button></td></tr>`).join('')}</tbody></table></div>`:'<div class="empty">Nenhuma ocorrência registrada.</div>'}</div>`}
function openMaintenance(){modal(`<h2>Registrar manutenção</h2><form id="maintenanceForm"><div class="form-grid"><div class="field"><label>Data</label><input type="date" name="data" value="${todayISO()}"></div><div class="field"><label>Local</label><select name="local">${['Flat 1','Flat 2','Flat 3','Flat 4','Flat 5','Flat 6','Área comum','Garagem','Instalações gerais'].map(x=>`<option>${x}</option>`).join('')}</select></div><div class="field full"><label>Descrição do problema</label><textarea name="problema" required></textarea></div><div class="field"><label>Prioridade</label><select name="prioridade"><option>Baixa</option><option selected>Média</option><option>Alta</option><option>Urgente</option></select></div><div class="field"><label>Responsável / fornecedor</label><input name="responsavel"></div></div><div class="form-actions"><button type="button" class="btn btn-light" onclick="closeModal()">Cancelar</button><button class="btn btn-primary">Registrar</button></div></form>`);$('#maintenanceForm').onsubmit=e=>{e.preventDefault();db.manutencoes.push({...Object.fromEntries(new FormData(e.target)),id:crypto.randomUUID(),status:'Aberta'});save();closeModal();render();toast('Ocorrência registrada')}}
function finishMaintenance(id){db.manutencoes=db.manutencoes.map(m=>m.id===id?{...m,status:m.status==='Concluída'?'Aberta':'Concluída'}:m);save();render()}
function mobile(p){const active=db.reservas.filter(r=>r.status!=='Cancelada'&&r.checkin<=todayISO()&&r.checkout>=todayISO());p.innerHTML=`<div class="mobile-panel"><div class="notice">Tela operacional para uso pelo celular. Selecione a reserva para registrar a chegada ou a saída. Antes de operar com dados reais, configure autenticação e armazenamento seguro no servidor.</div><div class="card" style="margin-top:16px"><div class="section-head"><div><h2>Check-in e check-out</h2><p>Reservas com estadia vigente hoje</p></div></div>${active.length?active.map(r=>`<div class="quick-item"><div><strong>${esc(r.nome)}</strong><div class="muted">${esc(r.flat)} · ${fmtDate(r.checkin)} a ${fmtDate(r.checkout)}</div><div style="margin-top:6px">${statusPill(r.status)}</div></div><div class="actions">${r.status!=='Hospedado'&&r.status!=='Concluída'?`<button class="btn btn-primary btn-small" onclick="markStay('${r.id}','Hospedado')">Check-in</button>`:''}${r.status==='Hospedado'?`<button class="btn btn-primary btn-small" onclick="markStay('${r.id}','Concluída')">Check-out</button>`:''}</div></div>`).join(''):'<div class="empty">Não há reservas com estadia prevista para hoje.</div>'}</div><div class="card" style="margin-top:16px"><h2 style="font-size:16px;margin-top:0">Checklist de chegada</h2><div class="quick-list">${['Confirmar identidade e dados da reserva','Conferir quantidade de hóspedes','Informar regras e horários da pousada','Entregar instruções de acesso ao flat','Registrar pendências ou observações'].map((x,i)=>`<label class="quick-item"><span>${x}</span><input type="checkbox" aria-label="${x}"></label>`).join('')}</div><p class="muted" style="font-size:10px">Checklist visual; os itens marcados não são vinculados ao cadastro.</p></div></div>`}
function markStay(id,status){db.reservas=db.reservas.map(r=>r.id===id?{...r,status}:r);save();render();toast(status==='Hospedado'?'Check-in registrado':'Check-out registrado')}
function relatorios(p){const porFlat=['Flat 1','Flat 2','Flat 3','Flat 4','Flat 5','Flat 6'].map(f=>({f,n:db.reservas.filter(r=>r.flat===f&&r.status!=='Cancelada').length}));p.innerHTML=`<div class="grid report-grid"><div class="card"><div class="stat-label">Valor total reservado</div><div class="stat-value">${money(totalReservas())}</div></div><div class="card"><div class="stat-label">Receita recebida</div><div class="stat-value">${money(recebido())}</div></div><div class="card"><div class="stat-label">Resultado registrado</div><div class="stat-value">${money(recebido()-despesas())}</div></div></div><div class="card" style="margin-top:18px"><div class="section-head"><div><h2>Reservas por flat</h2><p>Quantidade de reservas não canceladas cadastradas.</p></div><button class="btn btn-primary" onclick="exportCSV()">Exportar reservas CSV</button></div>${porFlat.map(x=>`<div style="margin:14px 0"><div class="quick-item"><strong>${x.f}</strong><span>${x.n} reservas</span></div><div class="progress"><span style="width:${Math.min(100,x.n*12)}%"></span></div></div>`).join('')}</div><div class="notice" style="margin-top:16px">Os indicadores consideram apenas os lançamentos cadastrados no sistema. Não representam conciliação bancária, lucro contábil ou ocupação histórica completa.</div>`}
function exportCSV(){const rows=[['Hóspede','Flat','Check-in','Check-out','Valor','Status','Origem'],...db.reservas.map(r=>[r.nome,r.flat,r.checkin,r.checkout,r.valor,r.status,r.origem])];const csv=rows.map(r=>r.map(v=>'"'+String(v??'').replaceAll('"','""')+'"').join(';')).join('\n');download(new Blob(['\ufeff'+csv],{type:'text/csv;charset=utf-8'}),'reservas-casa-sergio.csv')}
function modal(html){const b=document.createElement('div');b.className='modal-backdrop';b.id='modalBackdrop';b.innerHTML=`<div class="modal">${html}</div>`;b.addEventListener('click',e=>{if(e.target===b)closeModal()});document.body.appendChild(b)}
function closeModal(){const m=$('#modalBackdrop');if(m)m.remove()}
function esc(s){return String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}
function attr(s){return esc(s).replace(/`/g,'&#96;')}
$('#restoreInput').onchange=async e=>{const f=e.target.files[0];if(!f)return;try{db={...initial,...JSON.parse(await f.text())};save();render();toast('Backup restaurado')}catch{toast('Arquivo de backup inválido')}e.target.value=''};
$('#backupBtn').addEventListener('contextmenu',e=>{e.preventDefault();$('#restoreInput').click()});
$('#backupBtn').title='Clique para exportar backup. Clique com botão direito para restaurar.';
render();

